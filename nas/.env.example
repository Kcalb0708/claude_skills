# 群晖 NAS 接入配置模板。
# 把需要的键复制到目标项目自己的 secret manager 或已被 .gitignore 忽略的 .env。
# 不要在技能目录、源码、命令参数、日志或聊天中填写真实账号密码。

# DSM HTTPS 入口，不含 /webapi 和 NAS 文件路径。
# 内网示例：https://192.168.1.10:5001
# QuickConnect/反向代理示例：https://nas.example.com
NAS_DSM_URL=

# File Station 账号。只读任务使用专用只读账号；写任务使用受限写账号。
NAS_USERNAME=
NAS_PASSWORD=

# 本项目允许访问的最小 NAS 根目录。新项目必须设置。
# 业务层使用 /volume1 路径，脚本会在请求边界转换为 File Station 共享路径。
NAS_ALLOWED_ROOT=/volume1/<共享目录>/<项目目录>

# 目标子目录、负责人、素材分类等属于单次业务输入，不写入公共配置模板。
# TLS 校验默认开启。只有确认是可信内网自签名证书时，才在受控部署环境
# 临时设为 false 或给诊断脚本加 --insecure；不能把 false 提交成通用默认。
NAS_VERIFY_TLS=true

# 建连、普通 JSON 请求和文件传输分别设置超时，单位为秒。
NAS_CONNECT_TIMEOUT=15
NAS_READ_TIMEOUT=60
NAS_TRANSFER_TIMEOUT=180

# File Station List 单页上限。黄金适配器会继续分页并检测重复页。
NAS_LIST_PAGE_SIZE=500
